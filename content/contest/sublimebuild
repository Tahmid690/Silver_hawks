{
    "shell_cmd": "g++ -std=c++17 -O2 -Wall \"${file}\" -o \"${file_path}/${file_base_name}\"",
    "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
    "working_dir": "${file_path}",
    "selector": "source.c, source.c++",
    "variants":
    [
        {
            "name": "General",
            "shell_cmd": "g++ -std=c++17 -O2 -Wall \"${file}\" -o \"${file_path}/${file_base_name}\" && timeout 5 /usr/bin/time -f 'Time: %es | Memory: %MKB' \"${file_path}/${file_base_name}\" < input.txt > output.txt"
        },
        {
            "name": "StressTesting",
            "shell_cmd": "g++ -std=c++17 -O2 -Wall \"${file}\" -o \"${file_path}/${file_base_name}\" && g++ -std=c++17 -O2 \"${file_path}/naive.cpp\" -o \"${file_path}/naive\" && g++ -std=c++17 -O2 \"${file_path}/input_gen.cpp\" -o \"${file_path}/input_gen\" && chmod +x \"${file_path}/script.sh\" && \"${file_path}/script.sh\""
        }
    ]
}